# --- Core (Payload) ---
PAYLOAD_ENABLED=true
PAYLOAD_SECRET=
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# --- Site ---
# Local development only. On Vercel this is ignored: production resolves from
# VERCEL_PROJECT_PRODUCTION_URL and previews from VERCEL_URL (see
# src/lib/base-url.ts), so the dashboard needs no base-URL config.
#
# Canonical production host is the apex, lucassayeg.psc.br — Vercel's
# PRODUCTION_URL var tracks the *shortest* attached production domain, which is
# the apex. Attach www.lucassayeg.psc.br as a 308 redirect to the apex (not as a
# second primary domain), or canonical/sitemap/og URLs will point at a host that
# redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives messages from the contact form (Lucas's address).
CONTACT_EMAIL_TO=
# Sender shown in Lucas's inbox. Domain must be verified on Resend
# (https://resend.com/domains) — e.g. "Site Lucas Sayeg <contato@lucassayeg.com.br>".
# Leave empty to fall back to "Site Lucas Sayeg <onboarding@resend.dev>" (dev only).
CONTACT_EMAIL_FROM=


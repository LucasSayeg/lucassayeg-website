# --- Core (Payload) ---
PAYLOAD_ENABLED=true
PAYLOAD_SECRET=
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# --- Site ---
# Local development only. On Vercel this is ignored: production uses the pinned
# PRODUCTION_BASE_URL constant in src/lib/base-url.ts and previews use
# VERCEL_URL, so the dashboard needs no base-URL config.
#
# Canonical production host is the apex, https://lucassayeg.psc.br, with
# www.lucassayeg.psc.br 308-redirecting to it in Vercel. Changing the canonical
# host means editing BOTH the Vercel domain config and PRODUCTION_BASE_URL —
# the pinned constant must always name the host that serves 200, never one that
# redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives messages from the contact form (Lucas's address).
CONTACT_EMAIL_TO=
# Sender shown in Lucas's inbox. Domain must be verified on Resend
# (https://resend.com/domains) — e.g. "Site Lucas Sayeg <contato@lucassayeg.com.br>".
# Leave empty to fall back to "Site Lucas Sayeg <onboarding@resend.dev>" (dev only).
CONTACT_EMAIL_FROM=

